SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=

SKILLS_DIRS=./skills/
# SKILL_REPO_URLS=https://github.com/anthropics/skills  # comma-separated GitHub repos to fetch skills from
# GITHUB_TOKEN=                     # optional, raises GitHub API rate limits

LLM_MODEL=
LLM_EMBEDDING_MODEL=
LLM_PROXY_URL=
LLM_PROXY_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- bpmn-process-generation-skill 후처리(검증) ---
# process-gpt-completion 실행 엔진 base URL. 비우면 저장만 하고 실행 검증은 graceful skip.
COMPLETION_ENGINE_URL=
# 검증 자동교정 반복/대기 튜닝(선택)
PDF2BPMN_VALIDATION_MAX_ITERS=5
PDF2BPMN_VALIDATION_ADVANCE_TIMEOUT=70
PDF2BPMN_VALIDATION_CLEANUP=false

# Memento RAG 서버
MEMENTO_BASE_URL=http://127.0.0.1:8005

# 내부 파일 다운로드 엔드포인트용 자기 자신의 베이스 URL.
# 폼 출력에 포함된 샌드박스 파일(pdf/docx 등)을 다운로드 토큰 URL로 변환할 때 사용한다.
# 미설정 시 http://localhost:{PORT} 를 기본값으로 사용한다.
SELF_BASE_URL=http://localhost:8888


