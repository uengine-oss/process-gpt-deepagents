# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Public Storage — deliverable download links (bucket must exist and be public)
# SUPABASE_PUBLIC_FILES_BUCKET=files
# DISABLE_SUPABASE_STORAGE_UPLOAD=0

# Skills filesystem root (docker volume mount)
SKILLS_ROOT_DIR=/app/skills

# claude-skills HTTP file API (GitHub/config catalog skills — not always on the volume).
# Docker Compose: http://claude-skills:8765  |  local venv + local skills server: http://localhost:8765
# PROCESSGPT_SKILLS_API_BASE_URL=http://localhost:8765

# LLM
LLM_MODEL=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROXY_URL=http://litellm-proxy:4000
LLM_PROXY_API_KEY=sk-...

# Sandbox
SANDBOX_BASE_DIR=/tmp
# Optional: comma-separated globs scanned at task end for deliverable binaries (xlsx, pdf, …)
# OUTPUT_ARTIFACT_GLOBS=**/*.xlsx,**/*.csv,**/*.pdf
# OUTPUT_FILE_MAX_BYTES=26214400
# OUTPUT_FILE_MAX_COUNT=32
# DISABLE_SANDBOX_FILE_ARTIFACTS=0

# Polling
POLL_INTERVAL=5
POLL_LIMIT=5
APP_ENV=dev

# Memento RAG retrieve (optional). Default: https://memento.process-gpt.io/api/retrieve
# Local venv: http://localhost:8005/retrieve
# Docker Compose: http://host.docker.internal:8005/retrieve (if memento runs on the host)
# MEMENTO_RETRIEVE_URL=http://localhost:8005/retrieve
# 도메인 서브에이전트: 샌드박스 물리화/실행 전 memento 1회 강제(기본 활성). 비활성: 1/true/yes/on
# DISABLE_DOMAIN_MEMENTO_GATE=0
