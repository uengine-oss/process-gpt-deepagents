SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
# /skills* API 의 테넌트 접근 제어용 대칭키(레거시 HS256 프로젝트 전용).
# 최신 Supabase(JWT signing keys, ES256/RS256)는 JWKS 로 자동 검증되므로 비워두면 된다.
SUPABASE_JWT_SECRET=

SKILLS_DIRS=./skills/
# SKILL_REPO_URLS=https://github.com/anthropics/skills  # comma-separated GitHub repos to fetch skills from
# GITHUB_TOKEN=                     # optional, raises GitHub API rate limits

LLM_MODEL=
LLM_EMBEDDING_MODEL=
LLM_PROXY_URL=
LLM_PROXY_API_KEY=
# true 면 OpenAI 호출을 /v1/responses 로 보낸다(gpt-6-luna 같은 추론 모델의 도구 호출에 필요).
# LLM_USE_RESPONSES_API=false

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 넣으면 LangSmith 추적이 켜진다. 키가 있어도 끄려면 LANGSMITH_TRACING=false.
# LANGSMITH_API_KEY=

# --- bpmn-process-generation-skill 후처리(검증) ---
# process-gpt-completion 실행 엔진 base URL. 비우면 저장만 하고 실행 검증은 graceful skip.
COMPLETION_ENGINE_URL=
# 검증 자동교정 반복/대기 튜닝(선택)
PDF2BPMN_VALIDATION_MAX_ITERS=5
PDF2BPMN_VALIDATION_ADVANCE_TIMEOUT=70
PDF2BPMN_VALIDATION_CLEANUP=false

# Memento RAG 서버
MEMENTO_BASE_URL=http://127.0.0.1:8005

# 내부 파일 다운로드 엔드포인트용 자기 자신의 베이스 URL.
# 폼 출력에 포함된 샌드박스 파일(pdf/docx 등)을 다운로드 토큰 URL로 변환할 때 사용한다.
# 미설정 시 http://localhost:{PORT} 를 기본값으로 사용한다.
SELF_BASE_URL=http://localhost:8888

# --- 샌드박스 컨테이너 ---
# 샌드박스가 붙을 전용 브리지 네트워크와 그 MTU.
# 기본 브리지(1500)를 쓰면 경로 MTU 가 1460 이하인 환경(GKE 등)에서 큰 TLS 응답이
# 드롭돼 git clone/push 가 150초씩 매달리다 "Connection reset by peer" 로 죽는다.
# 0 으로 두면 종전처럼 기본 브리지를 쓴다.
SANDBOX_NETWORK_NAME=deepagent-sandbox-net
SANDBOX_NETWORK_MTU=1400

# 샌드박스 안에서 원격을 타는 git 명령(clone/fetch/push)의 상한(초).
GIT_NET_TIMEOUT_SECONDS=45

# 대화방별 스킬 체크아웃(.checkouts/<room>/)을 며칠 뒤 정리할지.
CHECKOUT_RETENTION_DAYS=7
