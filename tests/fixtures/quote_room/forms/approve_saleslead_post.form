<section>
  <div class='row' name='finance_approval_layout' alias='2차 승인(재무 담당)' is_multidata_mode='false'>
    <div class='col-sm-6'>
      <select-field name='approval_decision' alias='승인 여부' is_dynamic_load='fixed' items='[{"approve":"승인"},{"reject":"반려"}]'></select-field>
    </div>
    <div class='col-sm-6'>
      <textarea-field name='approval_reason' alias='승인/반려 사유' rows='4' disabled='false' readonly='false'></textarea-field>
    </div>
  </div>
</section>
